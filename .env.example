MYSQL_DATABASE=ecommerce_slim
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password

# Reverse-proxy deployment:
# - keep blank to let frontend call same-origin /api via nginx
# - set full URL only if frontend and backend are hosted on different origins
VITE_API_URL=
APP_CORS_ALLOWED_ORIGINS=https://shop.example.com
FRONTEND_PORT=80

APP_JWT_SECRET=change-this-jwt-secret-to-a-long-random-64-char-string
APP_JWT_TTL_SECONDS=604800
APP_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
APP_AUTH_RATE_LIMIT_BLOCK_SECONDS=900
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password-please
APP_BOOTSTRAP_ADMIN_FULL_NAME=TechNest Admin

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Image-based deploy via compose.prod.yaml can override these at runtime.
# BACKEND_IMAGE=ghcr.io/your-org/technest-backend:v1.0.0
# FRONTEND_IMAGE=ghcr.io/your-org/technest-frontend:v1.0.0
